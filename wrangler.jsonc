{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binder",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "binder",
      "database_id": "e8c9f205-08e7-4ae1-847b-8c2fec474345"
    }
  ]
}
